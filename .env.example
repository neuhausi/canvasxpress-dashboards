# Local config for the dev server (./server.sh) — copy to .env and edit:
#
#   cp .env.example .env
#   ./server.sh restart
#
# .env is gitignored; keep secrets there, never in the repo. These variables
# configure the DEV launcher (examples/serve.py). The self-hostable production
# server has its own richer config — see server/.env.example.

# --- Natural-language dashboard builder (the Chat view) ---------------------
# Anthropic API key (https://console.anthropic.com → API Keys). Server-side
# only — never sent to the browser. Leave unset to disable Chat authoring.
CXD_LLM_API_KEY=sk-ant-...

# LLM model id (optional; defaults to claude-opus-5).
# CXD_LLM_MODEL=claude-opus-5

# An Anthropic-compatible gateway instead of api.anthropic.com (optional), and
# the name of an extra header that also carries the key, if the gateway wants it.
# CXD_LLM_BASE_URL=https://gateway.example.org/anthropic
# CXD_LLM_KEY_HEADER=api-key

# --- Server binding (optional) ----------------------------------------------
# CXD_HOST=127.0.0.1
# CXD_PORT=8000

# Explicit Python to run the server with (auto-detected otherwise).
# CXD_PYTHON=python3.13

# --- canvasxpress-mcp (precise graph-config generation) ---------------------
# The Builder chat delegates single-chart requests to the canvasxpress-mcp
# server (validated CanvasXpress configs; RAG + knowledge base). Optional —
# when disabled/unreachable, the chat falls back to the LLM planner.
# CXD_MCP_ENABLED=1
# CXD_MCP_URL=http://127.0.0.1:8100
# CXD_MCP_TIMEOUT=90
# Authorization header value for an MCP server behind an authenticating proxy
# (e.g. "Bearer <token>", or "Key <api key>" on Posit Connect). Default none.
# CXD_MCP_AUTH=Key ...
# on: an unreachable/rejecting MCP server is an error (chat 502, /readyz fails)
# instead of a silent fallback to the LLM writing configs itself. Default off.
# CXD_MCP_REQUIRED=off
# JSONL log of every canvasxpress-mcp request/response (debugging generated
# configs). Empty/unset = logging off. The dev server defaults it to
# examples/.cxd-demo/mcp-bridge.log; read it via GET /api/llm/mcp-log?n=50.
# CXD_MCP_LOG=/path/to/mcp-bridge.log
# Show the Logs panel in the app rail (needs CXD_MCP_LOG). Default on.
# CXD_LOGS_PANEL=1
