# CanvasXpress Dashboards server — configuration
#
# Copy to `.env` and edit for your environment, then start with:
#     python -m cxd_server            # or the `cxd-server` console script
# A `.env` in the working directory is loaded automatically (needs the [web]
# extra, which includes python-dotenv). Every value below has a safe default;
# uncomment only what you need to change.

# --- security --------------------------------------------------------------
# Cookie-signing key. Leave UNSET to have the launcher generate and persist one
# (to CXD_SECRET_FILE) on first run. Set it explicitly in containers / multi-
# instance deploys so every instance shares the same key.
# SESSION_SECRET=change-me-to-a-long-random-string
# CXD_SECRET_FILE=./.session_secret
# Set to 1 to restrict the session cookie to HTTPS (behind TLS/a proxy).
# CXD_HTTPS_ONLY=0
# Allow account creation via /auth/signup ("1" default, "0" to lock down).
# ALLOW_SIGNUP=1
# Comma-separated usernames granted the admin user-management screen/API
# (create/list/delete users, reset passwords). The FIRST user to sign up is
# also made an admin automatically, so a fresh deployment always has one even
# if this is left empty.
# CXD_ADMINS=root,alice

# --- seeded accounts & example ownership (examples/serve.py dev launcher) ---
# The dev launcher seeds three accounts: demo (public visitor), app (owns the
# shipped example datasets/dashboards) and admin (maintainer, an admin). Set
# their passwords here; they are re-applied on every start. Defaults shown.
# CXD_DEMO_PASSWORD=demo1234
# CXD_APP_PASSWORD=app1234
# CXD_ADMIN_PASSWORD=admin1234
# Username whose datasets/dashboards are the shared, read-only "examples" merged
# into every user's lists (only an admin can edit/delete them). Default: app.
# CXD_EXAMPLES_OWNER=app

# --- network ---------------------------------------------------------------
# Bind address. Use 0.0.0.0 to accept connections from other hosts.
# CXD_HOST=127.0.0.1
# CXD_PORT=8000

# --- dashboard store (users + saved specs + share tokens) ------------------
# Default: stdlib SQLite at APP_DB_PATH (zero extra dependencies).
# APP_DB_PATH=./dashboards.db
# Use Postgres instead (needs the [postgres] extra, which bundles a driver; or
# the [sql] extra plus your own, e.g. psycopg2-binary):
# CXD_DASHBOARD_STORE=postgresql://user:pass@host:5432/dbname

# --- dataset / object stores (uploaded datasets) ---------------------------
# Default dataset store URI. Schemes: file:// s3:// postgresql:// sqlite:// gdrive://
# CXD_DATASET_STORE=file://./cxd-datasets
#   S3   (needs [s3]):     s3://my-bucket/prefix
#   SQL  (needs [sql]):    postgresql://user:pass@host/db?table=cxd_objects
#   Drive(needs [gdrive]): gdrive://<folderId>
# Optional named-store registry — inline JSON or a path to stores.json:
# CXD_STORES=./stores.json

# --- sharing ---------------------------------------------------------------
# Public base URL used to build share links (default: the request's own origin).
# CXD_PUBLISH_BASE_URL=https://dashboards.example.com

# --- CanvasXpress library --------------------------------------------------
# Base URL for the CanvasXpress library the served app loads (it fetches
# <base>/canvasXpress.css and <base>/canvasXpress.min.js). Point it at a
# self-hosted copy to run fully offline. Default: the public CDN.
# CXD_CANVASXPRESS_URL=https://www.canvasxpress.org/dist
# CanvasXpress license key — injected as window.cX before the library loads,
# which removes the watermark. Get one from CanvasXpress; leave unset otherwise.
# CXD_CANVASXPRESS_LICENSE=012A94618113866875DE9D49636735D1F8

# --- LLM (natural-language dashboard builder — POST /api/llm/dashboard) -----
# Secret API key for the NL builder. Kept SERVER-SIDE — never sent to the
# browser (the client only learns an LLM is configured). Leave unset to disable.
# CXD_LLM_API_KEY=sk-...
# CXD_LLM_MODEL=claude-opus-5   (default)
# Requires `pip install anthropic` on the server.

# --- Audit log (who did what; admin view + /api/admin/audit) ----------------
# On by default: an append-only, hash-chained cxd_audit table next to the
# dashboards. Set CXD_AUDIT=off to disable; CXD_AUDIT_RETENTION_DAYS prunes
# events older than N days (unset = keep everything).
# CXD_AUDIT=on
# CXD_AUDIT_RETENTION_DAYS=365

# --- Roles (Admin view: roles, groups; owners share with people/groups) ----
# The role of users with no role assigned to them or their groups:
# editor (default: create, upload, share, run functions, AI builder) | viewer
# (opens what is shared with them) | a custom role created in the Admin view.
# CXD_DEFAULT_ROLE=editor

# --- Single sign-on (OpenID Connect; docs/sso.md; needs the [sso] extra) ---
# CXD_OIDC_ISSUER=https://login.example.org/realms/acme
# CXD_OIDC_CLIENT_ID=cxd-dashboards
# CXD_OIDC_CLIENT_SECRET_FILE=/etc/cxd/oidc-secret
# CXD_OIDC_NAME=Acme SSO
# CXD_OIDC_GROUPS_CLAIM=groups
# CXD_OIDC_ADMIN_GROUPS=dashboards-admins
# CXD_OIDC_ALLOWED_DOMAINS=example.org
# CXD_OIDC_ONLY=off             # on: SSO only (CXD_ADMINS keep a password)
# CXD_OIDC_LINK_EXISTING=off    # on: SSO may sign into same-named local accounts

# --- Electronic signatures (docs/compliance.md) ---------------------------
# CXD_SIGNATURE_MEANINGS=Authored,Reviewed,Approved
# CXD_SIGN_REAUTH_SECONDS=300   # how recent an SSO sign-in must be to sign

# --- Scheduling (refresh, alerts, emailed dashboards; docs/scheduling.md) --
# CXD_SCHEDULER=on              # off: schedules only run by hand
# CXD_SCHEDULER_TICK=30         # seconds between checks
# Email is off until CXD_SMTP_HOST is set:
# CXD_SMTP_HOST=smtp.gmail.com
# CXD_SMTP_PORT=587
# CXD_SMTP_USER=bot@example.org
# CXD_SMTP_PASSWORD=app-password
# CXD_SMTP_PASSWORD_FILE=/home/me/.smtp.pass   # or read it from a chmod-600 file
# CXD_SMTP_FROM=bot@example.org
# CXD_SMTP_SECURITY=starttls    # starttls | ssl | none
# Links in emails need the public URL; snapshots need Playwright + Chromium:
# CXD_PUBLISH_BASE_URL=https://example.org/dashboards
# CXD_DASHBOARD_URL={base}/view.html?id={id}&owner={owner}
# CXD_INTERNAL_URL=http://127.0.0.1:8000
# CXD_SNAPSHOTS=on
# CXD_FETCH_ALLOW_PRIVATE=0     # 1: URL refreshes may reach private addresses
# CXD_EMAIL_VERIFY=on           # new addresses must be confirmed via an emailed link
# CXD_EMAIL_DAILY_CAP=50        # emails per person per day (0 = no cap)

# --- Data functions (kind:"function" sources — R / Python snippets) --------
# Runs USER-SUPPLIED CODE in a sandboxed subprocess. off (default) | admin | users.
# Use `users` only inside a container / VM you trust. Python needs pandas,
# R needs jsonlite. GET /api/functions/status shows what is in effect.
# CXD_FUNCTIONS=admin
# CXD_FUNCTIONS_TIMEOUT=20
# CXD_FUNCTIONS_MEMORY_MB=1024
# CXD_FUNCTIONS_MAX_CONCURRENT=2
# CXD_FUNCTIONS_PYTHON=/usr/bin/python3
# CXD_FUNCTIONS_RSCRIPT=/usr/bin/Rscript
# CXD_FUNCTIONS_WRAPPER=auto        # auto | none | e.g. "firejail --net=none"

# --- canvasxpress-mcp (precise graph-config generation) ---------------------
# The Builder chat delegates single-chart requests to the canvasxpress-mcp
# server (validated CanvasXpress configs; RAG + knowledge base). Optional —
# when disabled/unreachable, the chat falls back to the LLM planner.
# CXD_MCP_ENABLED=1
# CXD_MCP_URL=http://127.0.0.1:8100
# CXD_MCP_TIMEOUT=90
# JSONL log of every canvasxpress-mcp request/response (debugging generated
# configs). Empty/unset = logging off. The dev server defaults it to
# examples/.cxd-demo/mcp-bridge.log; read it via GET /api/llm/mcp-log?n=50.
# CXD_MCP_LOG=/path/to/mcp-bridge.log
# Show the Logs panel in the app rail (needs CXD_MCP_LOG). Default on.
# CXD_LOGS_PANEL=1
