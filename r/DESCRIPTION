Package: canvasXpressDashboards
Type: Package
Title: Linked Interactive Dashboards from 'CanvasXpress'
Version: 0.1.1
Authors@R: person("Isaac", "Neuhaus", email = "imnphd@gmail.com", role = c("aut", "cre"))
Description: Renders 'canvasxpress-dashboards' specs - multi-panel, linked
    'CanvasXpress' dashboards described by one JSON document - as an
    'htmlwidgets' widget for 'R Markdown', 'Quarto', the 'RStudio' viewer and 'shiny'.
    A data frame can be turned into a whole dashboard in one call: a patient
    cohort with survival columns, or a per-sample sequencing run-QC table, gets
    filters, linked charts and a click-to-load case card. See
    <https://www.canvasxpress.org> for more information.
License: GPL-3
Encoding: UTF-8
Language: en-US
URL: https://github.com/neuhausi/canvasxpress-dashboards
BugReports: https://github.com/neuhausi/canvasxpress-dashboards/issues
Depends:
    R (>= 3.6)
Imports:
    htmlwidgets (>= 1.5),
    htmltools,
    jsonlite
Suggests:
    shiny (>= 1.5),
    canvasXpress,
    testthat (>= 3.0.0)
Config/testthat/edition: 3
