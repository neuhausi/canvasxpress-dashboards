{
  "name": "canvasxpress-dashboards",
  "version": "0.15.0",
  "description": "Compose, coordinate, and render dashboards of linked CanvasXpress visualizations from a declarative spec.",
  "type": "module",
  "main": "dist/canvasxpress-dashboards.umd.js",
  "bin": {
    "cxd-spec": "bin/cxd-spec.mjs"
  },
  "module": "dist/canvasxpress-dashboards.esm.js",
  "exports": {
    ".": {
      "import": "./dist/canvasxpress-dashboards.esm.js",
      "require": "./dist/canvasxpress-dashboards.umd.js"
    },
    "./src": "./src/index.js",
    "./schema": "./schema/dashboard.schema.json"
  },
  "files": [
    "src",
    "dist",
    "schema",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"tests/**/*.test.js\"",
    "test:roundtrip": "node tests/browser/roundtrip.cjs",
    "test:ui": "node tests/browser/ui-chrome.cjs",
    "test:embed": "node tests/browser/embed.cjs",
    "test:figure": "node tests/browser/figure.cjs",
    "test:wizard": "node tests/browser/wizard.cjs",
    "test:wizard-dashboard": "node tests/browser/wizard-dashboard.cjs",
    "test:r": "node tests/browser/r-wrapper.cjs",
    "test:storyboard": "node tests/browser/storyboard.cjs",
    "test:demo": "node tests/browser/demo.cjs",
    "test:python": "node tests/browser/python-wrapper.cjs",
    "tokens": "node scripts/gen-ui-tokens.mjs",
    "tokens:check": "node scripts/gen-ui-tokens.mjs --check"
  },
  "keywords": [
    "canvasxpress",
    "dashboard",
    "dataviz",
    "visualization",
    "bi"
  ],
  "author": "Isaac Neuhaus",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neuhausi/canvasxpress-dashboards.git"
  },
  "peerDependencies": {
    "canvasxpress": ">=72.8.0"
  },
  "peerDependenciesMeta": {
    "canvasxpress": { "optional": true }
  }
}
