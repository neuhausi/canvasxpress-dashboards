  "panels": {
    "intro": {
      "type": "text",
      "html": "<div style=\"font-weight: 700; font-size: 25px\">KPI Overview</div><div style=\"font-size: 18px; color: #5b6472\">A backend-free KPI board: three ring-card meters summarize raw records into headline metrics, alongside a grouped orders bar and a 24-month revenue trend. Use the Region control to filter every panel.</div>"
    },
    "region-control": {
      "type": "control",
      "title": "Region",
      "dataRef": "ordersRegional",
      "annotation": "Region",
      "style": "dropdown"
    },
    "revenue-meter": {
      "title": "Total Revenue · 2025",
      "dataRef": "revenueMonthly",
      "config": {
        "graphType": "Meter",
        "meterType": "ring",
        "meterCard": true,
        "summaryType": "sum",
        "setMin": 0,
        "setMax": 10000,
        "xAxis": [
          "Revenue (k$)"
        ],
        "rangeColors": [
          "rgb(124,77,255)"
        ],
        "title": false
      }
    },
    "satisfaction-meter": {
      "title": "Customer Satisfaction",
      "dataRef": "satisfactionSurveys",
      "config": {
        "graphType": "Meter",
        "meterType": "ring",
        "meterCard": true,
        "summaryType": "average",
        "setMin": 0,
        "setMax": 100,
        "xAxis": [
          "CSAT"
        ],
        "rangeColors": [
          "rgb(38,166,154)"
        ],
        "title": false
      }
    },
    "uptime-meter": {
      "title": "Service Uptime · August",
      "dataRef": "uptimeDaily",
      "config": {
        "graphType": "Meter",
        "meterType": "ring",
        "meterCard": true,
        "summaryType": "average",
        "setMin": 0,
        "setMax": 100,
        "xAxis": [
          "Uptime (%)"
        ],
        "rangeColors": [
          "rgb(255,167,38)"
        ],
        "title": false
      }
    },
    "orders-bar": {
      "title": "Orders by Region and Quarter",
      "dataRef": "ordersRegional",
      "config": {
        "graphType": "Bar",
        "graphOrientation": "vertical",
        "colorScheme": "CanvasXpress",
        "title": false
      }
    },
    "revenue-line": {
      "title": "Monthly Revenue by Region · 24 months",
      "dataRef": "revenueTrend",
      "config": {
        "graphType": "Line",
        "graphOrientation": "vertical",
        "smpLabelRotate": 45,
        "title": false
      }
    }
  }
}
