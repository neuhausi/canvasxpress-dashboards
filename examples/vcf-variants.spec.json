 "panels": {
  "intro": {
   "type": "text",
   "title": false,
   "align": "left",
   "valign": "middle",
   "html": "<b>VCF ingestion.</b> A Variant Call Format file (multi-sample, with INFO and genotype fields) parsed to a CanvasXpress data object — variants per chromosome, and every variant's quality by position. Bind the same parse to a Manhattan or genome panel for a positional view."
  },
  "perchr": {
   "title": "Variants per chromosome",
   "dataRef": "perChr",
   "config": {
    "graphType": "Bar",
    "graphOrientation": "vertical",
    "colorBy": "Variants",
    "xAxisTitle": "Chromosome",
    "yAxisTitle": "Variants",
    "title": false
   },
   "provenance": {
    "show": true,
    "notes": "parsed from VCF with parseVcf()"
   }
  },
  "qual": {
   "title": "Variant quality by position",
   "dataRef": "variants",
   "config": {
    "graphType": "Scatter2D",
    "xAxis": [
     "POS"
    ],
    "yAxis": [
     "QUAL"
    ],
    "colorBy": "CHROM",
    "xAxisTitle": "Position",
    "yAxisTitle": "QUAL",
    "title": false
   }
  },
  "about": {
   "type": "text",
   "title": false,
   "align": "left",
   "valign": "top",
   "html": "Data are <b>synthetic</b> (deterministic). The VCF is parsed by <code>parseVcf()</code> → <code>vcfToData()</code> / <code>variantsPerChromosome()</code>; see <code>docs/science-panels.md</code>."
  }
 }
