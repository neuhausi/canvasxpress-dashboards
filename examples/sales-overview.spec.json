{
  "id": "sales-overview",
  "title": "Sales Overview",
  "version": 1,
  "broadcastGroup": "sales-overview",
  "theme": "auto",
  "layout": {
    "cols": 12,
    "rowHeight": 130,
    "gap": 12,
    "items": [
      {
        "panel": "intro",
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 1
      },
      {
        "panel": "revenue-bar",
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 3
      },
      {
        "panel": "region-pie",
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 3
      },
      {
        "panel": "trend-line",
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 3
      }
    ]
  },
  "data": {
    "sales": {
      "kind": "inline",
