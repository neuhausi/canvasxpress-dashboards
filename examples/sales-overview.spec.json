  "panels": {
    "intro": {
      "type": "text",
      "html": "<div style=\"font-weight: 700; font-size: 25px\">Sales Overview</div><div style=\"font-size: 18px; color: #5b6472\">A backend-free sales showcase: three linked panels — revenue by region (bar), share (pie) and a monthly trend line — plus a broadcast-aware table. Click anything and the selection coordinates across the board.</div>"
    },
    "revenue-bar": {
      "title": "Revenue by Region",
      "dataRef": "sales",
      "config": {
        "graphType": "Bar",
        "colorBy": "Region",
        "showLegend": false,
        "title": false
      }
    },
    "region-pie": {
      "title": "Share by Region",
      "dataRef": "sales",
      "config": {
        "graphType": "Pie",
        "colorBy": "Region",
        "title": false
      }
    },
    "trend-line": {
      "title": "Quarterly Trend",
      "dataRef": "trend",
      "config": {
        "graphType": "Line",
        "title": false
      }
    }
  },
  "controls": [
    {
      "kind": "table",
      "dataRef": "sales",
      "title": "Sales Table"
    }
  ]
}
