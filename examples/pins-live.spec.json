{
 "$schema": "https://canvasxpress.org/schema/dashboard.schema.json",
 "schemaVersion": "1.3",
 "id": "pins-live",
 "title": "Pins Board (live connector)",
 "version": 1,
 "theme": "auto",
 "markingMode": "filter",
 "layout": {
  "cols": 12,
  "rowHeight": 40,
  "gap": 12,
  "items": [
   {
    "panel": "intro",
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 2
   },
   {
    "panel": "species",
    "x": 0,
    "y": 2,
    "w": 3,
    "h": 18
   },
   {
    "panel": "bill",
    "x": 3,
    "y": 2,
    "w": 9,
    "h": 9
   },
   {
    "panel": "measures",
    "x": 3,
    "y": 11,
    "w": 9,
    "h": 9
   }
  ]
 },
 "data": {
  "penguins": {
   "kind": "connector",
   "url": "/connectors/api/data?source=pins-penguins"
  }
 },
 "panels": {
  "intro": {
   "type": "text",
   "html": "<b>Live from a Posit pins board, via the connector.</b> The Palmer Penguins table was published to a pins <code>board_folder</code> with <code>pin_write()</code> \u2014 exactly what an analyst produces \u2014 and is read back here through the real <code>PinsBoardSource</code> connector (<code>GET /connectors/api/data?source=pins-penguins</code>). Nothing is baked: the server reads the pin live, reshapes it, and the browser only ever sees the chart data. Change the pin and refresh, and these panels update. Pick a species to filter both charts."
  },
  "species": {
   "type": "control",
   "title": "Species",
   "dataRef": "penguins",
   "annotation": "species",
   "style": "dropdown"
  },
  "bill": {
   "title": "Bill shape by species",
   "dataRef": "penguins",
   "config": {
    "graphType": "Scatter2D",
    "xAxis": [
     "bill_length_mm"
    ],
    "yAxis": [
     "bill_depth_mm"
    ],
    "colorBy": "species",
    "title": "Bill shape by species",
    "xAxisTitle": "Bill length (mm)",
    "yAxisTitle": "Bill depth (mm)"
   }
  },
  "measures": {
   "title": "Flipper length vs. body mass",
   "dataRef": "penguins",
   "config": {
    "graphType": "Scatter2D",
    "xAxis": [
     "flipper_length_mm"
    ],
    "yAxis": [
     "body_mass_g"
    ],
    "colorBy": "species",
    "title": "Flipper length vs. body mass",
    "xAxisTitle": "Flipper length (mm)",
    "yAxisTitle": "Body mass (g)"
   }
  }
 }
}
