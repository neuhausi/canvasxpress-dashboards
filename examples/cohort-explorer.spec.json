          "os_months"
        ],
        "yAxis": [
          "os_event"
        ],
        "colorBy": "arm",
        "title": false,
        "xAxisTitle": "Months",
        "yAxisTitle": "Survival"
      }
    },
    "pdl1": {
      "title": "PD-L1 (CD274) vs survival",
