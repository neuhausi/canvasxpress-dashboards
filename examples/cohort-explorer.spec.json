      "config": {
        "graphType": "Scatter2D",
        "xAxis": [
          "CD274"
        ],
        "yAxis": [
          "os_months"
        ],
        "colorBy": "arm",
        "title": false,
        "xAxisTitle": "CD274 (log2)",
