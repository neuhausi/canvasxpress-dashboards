  "panels": {
    "intro": {
      "type": "text",
      "title": "",
      "text": "Slide the **FDR threshold** to re-filter the significance brackets (dashboard-scope BH correction); switch the **Transform** to re-express the data (log/z-score/normalize). Analysis controls re-run the analysis, not just the display."
    },
    "box": {
      "title": "Tooth growth by dose",
      "dataRef": "box",
      "config": {
        "graphType": "Boxplot",
        "groupingFactors": [
          [
            "group"
          ]
        ],
        "title": "Tooth growth by dose with pairwise significance (Welch t-test, BH-adjusted)",
        "xAxisTitle": "value",
        "smpTitle": "group",
        "showBoxplotIfViolin": true,
        "setMaxX": 13.6,
        "showStatInference": true,
        "statInference": {
          "correction": {
            "method": "BH",
            "scope": "panel"
          },
          "annotate": "stars",
          "comparisons": [
            {
              "groups": [
                "Control",
                "DoseA"
              ],
              "p": 0.00258746,
              "value": 10.62
            },
            {
              "groups": [
                "Control",
                "DoseB"
              ],
              "p": 4.7e-7,
              "value": 11.36
            },
            {
              "groups": [
                "DoseA",
                "DoseB"
              ],
              "p": 0.00116248,
              "value": 12.11
            },
            {
              "groups": [
                "Control",
                "DoseC"
              ],
              "p": 0.53069114,
              "value": 13.01
            }
          ]
        },
        "graphOrientation": "vertical"
      }
    },
    "tf": {
      "type": "control",
      "mode": "transform",
      "target": "box",
      "title": "Transform",
      "analysis": "transform",
      "value": "none",
      "options": [
        {
          "label": "None",
          "value": "none"
        },
        {
          "label": "log2",
          "value": "log2"
        },
        {
          "label": "log10",
          "value": "log10"
        },
        {
          "label": "Z-score",
          "value": "zscore"
        },
        {
          "label": "Median-center",
          "value": "medianCenter"
        },
        {
          "label": "Quantile normalize",
          "value": "quantileNormalize"
        }
      ]
    },
    "fdr": {
      "type": "control",
      "mode": "param",
      "style": "range",
      "param": "fdr",
      "title": "FDR threshold",
      "analysis": "fdr",
      "method": "BH",
      "min": 0.001,
      "max": 0.25,
      "step": 0.001,
      "value": 0.05
    }
  },
