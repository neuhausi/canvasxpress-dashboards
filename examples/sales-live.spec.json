{
  "id": "sales-live",
  "title": "Sales (live from database)",
  "version": 1,
  "broadcastGroup": "sales-live",
  "layout": {
    "cols": 12,
    "rowHeight": 130,
    "items": [
      {
        "panel": "intro",
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 2
      },
      {
        "panel": "revenue-bar",
        "x": 0,
        "y": 2,
        "w": 6,
        "h": 3
      },
      {
        "panel": "region-pie",
        "x": 6,
        "y": 2,
        "w": 6,
        "h": 3
      }
    ]
  },
  "data": {
    "sales": {
      "kind": "connector",
      "url": "/connectors/api/data?source=sales",
      "ttl": 60000,
      "refresh": 300
    }
  },
  "panels": {
    "revenue-bar": {
      "title": "Revenue by Region",
      "dataRef": "sales",
      "config": {
        "graphType": "Bar",
        "title": false
      }
    },
    "region-pie": {
      "title": "Share by Region",
      "dataRef": "sales",
      "config": {
        "graphType": "Pie",
        "title": false
      }
    },
    "intro": {
      "type": "text",
      "html": "<div style=\"font-weight: 700; font-size: 25px\">Sales (live from database)</div><div style=\"font-size: 18px; color: var(--cxd-muted)\">A sales board bound to a live database over a connector — revenue by region and share by region query the database on load, with no data copied into the dashboard.</div>"
    }
  },
  "controls": [
    {
      "kind": "table",
      "dataRef": "sales",
      "title": "Sales Table"
    }
  ]
}