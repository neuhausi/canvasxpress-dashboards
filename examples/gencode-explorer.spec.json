{
  "id": "gencode-explorer",
  "title": "GENCODE Genome Browser (live)",
  "version": 2,
  "broadcastGroup": "gencode-explorer",
  "theme": "auto",
  "params": {
    "gene": {
      "value": "TYK2",
      "type": "string"
    }
  },
  "layout": {
    "cols": 12,
    "rowHeight": 40,
    "gap": 12,
    "items": [
      {
        "panel": "intro",
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 2
      },
      {
        "panel": "gene-control",
        "x": 0,
        "y": 2,
        "w": 6,
        "h": 1
      },
      {
        "panel": "browser",
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 13
      },
      {
        "panel": "locus",
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 13
      }
    ]
  },
  "data": {
    "genesList": {
      "kind": "connector",
      "url": "../api/gencode",
      "query": {
        "list": "genes"
      },
      "ttl": 600000
    },
    "browser": {
      "kind": "connector",
      "url": "../api/gencode",
      "query": {
        "gene": "$gene"
      },
      "ttl": 0
    },
    "locus": {
      "kind": "connector",
      "url": "../api/gencode",
      "query": {
        "gene": "$gene",
        "view": "locus"
      },
      "ttl": 0
    }
  },
  "panels": {
    "gene-control": {
      "type": "control",
      "mode": "param",
      "param": "gene",
      "title": "Gene",
      "style": "search",
      "placeholder": "gene symbol (e.g. TYK2, TP53, BRCA1)",
      "optionsFrom": {
        "dataRef": "genesList",
        "annotation": "gene"
      }
    },
    "browser": {
      "title": "Genome browser \u2014 transcript exon models + GWAS Catalog SNPs in the region",
      "dataRef": "browser",
      "config": {
        "graphType": "Genome",
        "featureStaggered": true,
        "subtracksMaxDefault": 10,
        "dataPointSize": 6,
        "theme": "GGPlot",
        "colorScheme": "Favorite",
        "title": false
      }
    },
    "intro": {
      "type": "text",
      "html": "<div style=\"font-weight: 700; font-size: 25px\">GENCODE Genome Browser (live)</div><div style=\"font-size: 18px; color: var(--cxd-muted)\">GENCODE genome browser \u2014 search a gene to view its transcript/exon models and nearby GWAS Catalog variants along the chromosome. Below the browser, the same window is drawn as a regional association (LocusZoom) plot: GENCODE transcript models under the GWAS Catalog associations as -log10(p). Data: GENCODE annotation + GWAS Catalog.</div>"
    },
    "locus": {
      "title": "Regional association (LocusZoom) \u2014 GWAS Catalog -log10(p) over the same window",
      "dataRef": "locus",
      "config": {
        "graphType": "Genome",
        "featureStaggered": true,
        "featurePriority": [
          "protein_coding"
        ],
        "subtracksMaxDefault": 10,
        "genomeTicks": 8,
        "genomeTicksUnit": "auto",
        "genomeTrackPadding": 0.04,
        "xAxisLineBottomShow": true,
        "yAxisLineLeftShow": true,
        "decorations": {
          "line": [
            {
              "y": 7.30103,
              "color": "rgb(169,169,169)",
              "width": 1,
              "type": "dashed"
            }
          ]
        },
        "dataPointSize": 6,
        "theme": "GGPlot",
        "colorScheme": "Favorite",
        "title": false
      }
    }
  }
}
