 "panels": {
  "intro": {
   "type": "text",
   "title": false,
   "align": "left",
   "valign": "middle",
   "html": "<b>Mutation landscape.</b> A synthetic gene × sample alteration matrix (mutation + copy-number tokens). Drop the token matrix and the wizard suggests an <b>Oncoprint</b> — a cBioPortal-style waterfall that stacks mutations and CNAs per gene and orders samples by alteration."
  },
  "onco": {
   "title": "Alterations across the cohort (Oncoprint)",
   "dataRef": "alterations",
   "config": {
