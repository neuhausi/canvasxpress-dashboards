    "title": false
   }
  },
  "freq": {
   "title": "Alteration frequency by gene",
   "dataRef": "freq",
   "config": {
    "graphType": "Bar",
    "graphOrientation": "vertical",
    "colorBy": "Altered",
    "smpLabelRotate": 45,
    "yAxisTitle": "% samples altered",
